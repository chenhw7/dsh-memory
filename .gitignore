# Dependencies
node_modules/

# Local npm cache (read-only $HOME in DSH sandbox sessions)
.npm-cache/

# Build output
lib/
*.tsbuildinfo

# Environment & secrets
.env
.env.*
!.env.example

# Machine-local profile backups (never commit host-specific manifests)
.profile-backup*/

# OS files
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*

.zcode/
# Local session exports (personal data — never commit)
dsh-session-*.zip

# Local security-scanner state (machine-local baselines, never commit)
.mimosa/
/eval.yaml
