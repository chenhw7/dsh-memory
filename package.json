{
  "name": "@chenhw7/dsh-memory",
  "version": "0.6.0",
  "description": "Cairn — long-term memory for the DeepSeek Harness: persistent cross-session memory (store, tools, auto-extraction, context injection) as one installable profile bundle",
  "type": "module",
  "homepage": "https://chenhw7.github.io/dsh-memory/",
  "repository": {
    "type": "git",
    "url": "https://github.com/chenhw7/dsh-memory.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "memory",
    "long-term-memory",
    "agent-memory",
    "cross-session",
    "bm25",
    "llm-agents",
    "plugin"
  ],
  "bugs": {
    "url": "https://github.com/chenhw7/dsh-memory/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./store": {
      "types": "./lib/store/index.d.ts",
      "default": "./lib/store/index.js"
    },
    "./tool": {
      "types": "./lib/tool/index.d.ts",
      "default": "./lib/tool/index.js"
    },
    "./review": {
      "types": "./lib/review/index.d.ts",
      "default": "./lib/review/index.js"
    },
    "./context": {
      "types": "./lib/context/index.d.ts",
      "default": "./lib/context/index.js"
    },
    "./notes": {
      "types": "./lib/notes/index.d.ts",
      "default": "./lib/notes/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./benchmark": {
      "types": "./lib/benchmark/index.d.ts",
      "default": "./lib/benchmark/index.js"
    },
    "./remote": {
      "types": "./lib/remote/typert.remote-client.d.ts",
      "default": "./lib/remote/typert.remote-client.js"
    },
    "./remote-service": {
      "types": "./lib/remote/index.d.ts",
      "default": "./lib/remote/index.js"
    },
    "./client": {
      "default": "./lib/client/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/fix-imports.cjs && node scripts/build-client.cjs",
    "prepare": "echo skip",
    "prepublishOnly": "npm run build && npm run test",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-storage-json": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-brand": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-compaction": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-brand": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-compaction": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-storage": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-storage-json": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.5 || ^0.1.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.0",
    "zod": "^4.4.3"
  }
}
